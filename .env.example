# Copy to .env and fill in real values. Never commit .env.
ENVIRONMENT=local
DEBUG=true

# --- Web / API ---
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-me-to-a-random-32-char-secret

# --- Database ---
DATABASE_URL=postgresql+asyncpg://openvoice:openvoice@localhost:5432/openvoice
DATABASE_POOL_SIZE=10
DATABASE_ECHO=false

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- LLM provider: anthropic | openai | self_hosted ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
SELF_HOSTED_LLM_BASE_URL=
SELF_HOSTED_LLM_MODEL=
LLM_REQUEST_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=3

# --- STT / TTS providers ---
STT_PROVIDER=faster_whisper
TTS_PROVIDER=piper
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# --- Observability ---
SENTRY_DSN=
LOG_LEVEL=INFO
