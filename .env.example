# Copy to .env and fill in real values. Never commit .env.
ENVIRONMENT=local
DEBUG=true

# --- Web / API ---
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-me-to-a-random-32-char-secret

# --- Database ---
DATABASE_URL=postgresql+asyncpg://openvoice:openvoice@localhost:5432/openvoice
DATABASE_POOL_SIZE=10
DATABASE_ECHO=false

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- LLM provider: anthropic | openai | openai_compatible ---
# `openai_compatible` is not a single vendor: it's any endpoint that speaks
# the OpenAI Chat Completions protocol. That covers hosted providers
# requiring an API key (DeepSeek, Moonshot/Kimi, Alibaba Qwen, Groq,
# Together AI, ...) as well as a self-hosted vLLM/llama.cpp/Ollama server
# (leave OPENAI_COMPATIBLE_API_KEY empty for those). Examples:
#   DeepSeek : OPENAI_COMPATIBLE_BASE_URL=https://api.deepseek.com/v1
#              OPENAI_COMPATIBLE_MODEL=deepseek-chat
#   Kimi     : OPENAI_COMPATIBLE_BASE_URL=https://api.moonshot.ai/v1
#              OPENAI_COMPATIBLE_MODEL=kimi-k2-0711-preview
#   Qwen     : OPENAI_COMPATIBLE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#              OPENAI_COMPATIBLE_MODEL=qwen-plus
#   Groq     : OPENAI_COMPATIBLE_BASE_URL=https://api.groq.com/openai/v1
#              OPENAI_COMPATIBLE_MODEL=llama-3.3-70b-versatile
#   local    : OPENAI_COMPATIBLE_BASE_URL=http://localhost:8000/v1
# Always check the provider's own docs for their current model names.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_API_KEY=
LLM_REQUEST_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=3

# --- STT / TTS providers ---
STT_PROVIDER=faster_whisper
TTS_PROVIDER=piper
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_turbo_v2_5
FASTER_WHISPER_MODEL_SIZE=small
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE_TYPE=int8
# A local Piper voice is single-language: download a `.onnx`+`.onnx.json`
# pair for whatever language your callers speak from
# https://huggingface.co/rhasspy/piper-voices and point this at it (e.g.
# `models/piper/fr_FR-siwis-medium.onnx` for French). It's resampled to
# whatever rate the call needs, so any Piper voice's native sample rate
# works here.
PIPER_VOICE_MODEL_PATH=models/piper/en_US-amy-medium.onnx

# --- Agent (per-company, never hardcoded in business logic) ---
AGENT_COMPANY_NAME=our company
AGENT_SYSTEM_PROMPT=
AGENT_MAX_HISTORY_TURNS=20
AGENT_HUMAN_TRANSFER_NUMBER=

# --- Voice turn-taking ---
# How long (seconds) of silence before the agent considers the caller done
# speaking. Lower = snappier but risks cutting off mid-pause; higher = more
# patient but reads as slow to respond.
VAD_MIN_SILENCE_DURATION_SECONDS=0.4

# --- Calendar / booking: google ---
# Also gates voice-driven booking: ConversationManager only gets the
# check_availability/book_appointment/cancel_appointment/
# reschedule_appointment/list_my_appointments tools when a calendar
# provider is configured (see openvoice.telephony.worker._build_booking_tools)
# and the caller's phone number resolved to a client -- without both, the
# agent still works, just without booking actions.
CALENDAR_PROVIDER=google
GOOGLE_CALENDAR_ID=primary
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=
BOOKING_BUSINESS_HOURS_START=9
BOOKING_BUSINESS_HOURS_END=17
BOOKING_DEFAULT_DURATION_MINUTES=30
BOOKING_SEARCH_DAYS_AHEAD=7
# Also told to the agent (see openvoice.agent.prompts.build_temporal_context)
# so it can resolve what the caller means by "tomorrow afternoon" into a real,
# timezone-aware datetime for a booking tool call -- use the business's real
# timezone here (e.g. Europe/Paris), not just UTC, or every relative date the
# agent resolves out loud will be off by the UTC offset.
BOOKING_TIMEZONE=UTC

# --- SMS / email notifications ---
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NOTIFICATION_REQUEST_TIMEOUT_SECONDS=10
NOTIFICATION_MAX_RETRIES=3

# --- Observability ---
SENTRY_DSN=
LOG_LEVEL=INFO
